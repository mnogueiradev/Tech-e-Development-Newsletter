# Banco de dados TiDB
TIDB_URL=mysql://usuario:senha@gateway.tidbcloud.com:4000/test
# Em produção a primeira inicialização salva a fingerprint fora do repositório, em ~/.newsletter.
# Para aprovar uma troca intencional de banco, confirme os dados e informe aqui a saída de
# `npm run db:fingerprint`. Opcional: use TIDB_FINGERPRINT_FILE em volume persistente.
# TIDB_EXPECTED_FINGERPRINT=
# TIDB_FINGERPRINT_FILE=

# API Resend (envio de emails)
RESEND_API_KEY=sua_chave_da_resend_aqui

# API Brave News
BRAVE_API_KEY=sua_chave_brave_aqui

# Descoberta editorial automática: desativada até a migration 002 ser aplicada.
EDITORIAL_DISCOVERY_ENABLED=false
EDITORIAL_DISCOVERY_LEAD_HOURS=24
EDITORIAL_DISCOVERY_MAX_DURATION_MINUTES=30
EDITORIAL_DISCOVERY_MAX_ATTEMPTS=3
EDITORIAL_DISCOVERY_RETRY_DELAY_MINUTES=15
EDITORIAL_DISCOVERY_POLL_CRON=* * * * *
EDITORIAL_PUBLICATION_TIMEZONE=America/Sao_Paulo
EDITORIAL_PUBLICATION_TIME=08:00
# Opcional, para múltiplas edições/fusos: JSON, ex. [{"id":"br","timezone":"America/Sao_Paulo","time":"08:00"}]
# EDITORIAL_PUBLICATION_SCHEDULES=

# Porta do servidor
PORT=3000

# =======================
# PAINEL DE ADMINISTRAÇÃO
# =======================
ADMIN_EMAIL=seu@email.com
ADMIN_PASSWORD=uma_senha_muito_segura

# Token para /trigger-email e rotas admin sensíveis (use o mesmo no cron externo)
ADMIN_TOKEN=um_token_alfanumerico_aleatorio_seguro

# JWT do painel admin (opcional — fallback: ADMIN_TOKEN)
JWT_SECRET=

# =======================
# FRONTEND (build)
# =======================
# Deixe vazio se frontend e backend rodam no mesmo domínio (Oracle Cloud).
# Só defina se API estiver em host diferente do site.
# NEXT_PUBLIC_API_URL=https://techndevn.com

# =======================
# CRON EXTERNO (deploy/trigger-newsletter.sh)
# =======================
# NEWSLETTER_URL=https://techndevn.com
